{
  "name": "maguru-auto-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply maguru_auto --local",
    "db:migrate:remote": "wrangler d1 migrations apply maguru_auto --remote",
    "db:seed:local": "wrangler d1 execute maguru_auto --local --file=./migrations/0002_seed_admin.sql"
  },
  "dependencies": {
    "hono": "^4.7.2"
  },
  "devDependencies": {
    "wrangler": "^4.18.0"
  }
}
